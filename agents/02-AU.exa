; Persistent audio controller. Global M commands come only from GM.
; BEGIN GENERATED SPLASH TILE
COPY 108 GP
COPY 109 GP
COPY 90 GX
COPY 30 GY
; END GENERATED SPLASH TILE
COPY M T
COPY 300 GP
@REP 3
WAIT
@END
LINK 801
COPY 0 #SQR0
COPY 0 #SQR1
COPY 0 #TRI0
COPY 0 #NSE0

MARK COMMAND
COPY M X

MARK DISPATCH
COPY 0 #SQR0
COPY 0 #SQR1
COPY 0 #TRI0
COPY 0 #NSE0
TEST X = 1
TJMP SOUND_TICK
TEST X = 2
TJMP SOUND_CONFIRM
TEST X = 3
TJMP SOUND_COUNTDOWN
TEST X = 4
TJMP SOUND_RACE
TEST X = 5
TJMP SOUND_WIN
TEST X = 6
TJMP SOUND_LOSS
JUMP COMMAND

MARK SOUND_TICK
COPY 67 #SQR0
WAIT
COPY 0 #SQR0
JUMP COMMAND

MARK SOUND_CONFIRM
COPY 55 #SQR0
COPY 67 #SQR1
WAIT
COPY 60 #SQR0
COPY 72 #SQR1
WAIT
COPY 0 #SQR0
COPY 0 #SQR1
JUMP COMMAND

MARK SOUND_COUNTDOWN
COPY 60 #SQR1
WAIT
COPY 0 #SQR1
JUMP COMMAND

; Gallop until GM sends the result command.
MARK SOUND_RACE
COPY 43 #TRI0
COPY 22 #NSE0
WAIT
COPY 0 #TRI0
COPY 0 #NSE0
WAIT
TEST MRD
FJMP SOUND_RACE
COPY M X
JUMP DISPATCH

MARK SOUND_WIN
COPY 60 #SQR0
COPY 67 #SQR1
COPY 72 #TRI0
WAIT
COPY 64 #SQR0
COPY 72 #SQR1
COPY 76 #TRI0
WAIT
COPY 67 #SQR0
COPY 76 #SQR1
COPY 79 #TRI0
WAIT
WAIT
COPY 0 #SQR0
COPY 0 #SQR1
COPY 0 #TRI0
JUMP COMMAND

MARK SOUND_LOSS
COPY 35 #SQR0
COPY 35 #SQR1
COPY 45 #NSE0
WAIT
COPY 28 #SQR0
COPY 25 #SQR1
COPY 28 #NSE0
WAIT
COPY 18 #NSE0
WAIT
COPY 0 #SQR0
COPY 0 #SQR1
COPY 0 #NSE0
JUMP COMMAND
