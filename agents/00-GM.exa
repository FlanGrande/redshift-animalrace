; Animal Race game manager and runtime worker template.
; Main state: X=bank, CO=selected racer, GZ=wager.
; Held file: odds for racers 1 through 5.
DATA 0 0 0 0 0

; Boot controller wakes all three game EXAs after the Flan splash.
COPY -10 GX
COPY -10 GY
COPY M T
COPY 10 X
COPY 1 CO
COPY 1 GZ
COPY 0 GX
COPY 14 GY
LINK 800
MODE

; Five lane-sized finish markers.
COPY 14 T
REPL FINISH_LINE
COPY 31 T
REPL FINISH_LINE
COPY 48 T
REPL FINISH_LINE
COPY 65 T
REPL FINISH_LINE
COPY 82 T
REPL FINISH_LINE

; Fresh racers are created every round. T carries identity into each clone.
MARK ROUND_SETUP
COPY 1 T
REPL RACER
COPY 2 T
REPL RACER
COPY 3 T
REPL RACER
COPY 4 T
REPL RACER
COPY 5 T
REPL RACER

; Racers only write local M; GM is the only local M reader.
MARK COLLECT_ODDS
@REP 5
COPY M T
SWIZ T 0002 GX
SUBI GX 1 GX
SEEK GX
SWIZ T 0001 F
SEEK -9999
@END
COPY 0 GX
COPY 1 CO
COPY 1 GZ
COPY 14 GY
REPL BET_BANK_HUNDREDS
REPL BET_BANK_TENS
REPL BET_BANK_ONES

; Do not accept a Start press carried over from the prior round.
MARK RELEASE_START_PICK
WAIT
SWIZ #PADB 0004 T
TJMP RELEASE_START_PICK

; Pick one of five racers with up/down.
MARK PICK_LOOP
WAIT
SWIZ #PADB 0004 T
TJMP PICK_DONE
COPY #PADY T
TJMP PICK_INPUT
JUMP PICK_LOOP

MARK PICK_INPUT
ADDI CO #PADY CO
TEST CO < 1
TJMP PICK_WRAP_UP
TEST CO > 5
TJMP PICK_WRAP_DOWN
JUMP PICK_MOVED

MARK PICK_WRAP_UP
COPY 5 CO
JUMP PICK_MOVED

MARK PICK_WRAP_DOWN
COPY 1 CO

MARK PICK_MOVED
SUBI CO 1 T
MULI T 17 T
ADDI 14 T GY
MODE
COPY 1 M
MODE

MARK RELEASE_PICK
WAIT
TEST #PADY = 0
FJMP RELEASE_PICK
JUMP PICK_LOOP

MARK PICK_DONE
MODE
COPY 2 M
MODE
COPY 1 GZ

MARK RELEASE_START_WAGER
WAIT
SWIZ #PADB 0004 T
TJMP RELEASE_START_WAGER

; Choose a $1-$9 wager with left/right, capped by the bank.
MARK WAGER_LOOP
REPL WAGER_DIGIT
WAIT
SWIZ #PADB 0004 T
TJMP WAGER_DONE
COPY #PADX T
TJMP WAGER_INPUT
JUMP WAGER_LOOP

MARK WAGER_INPUT
ADDI GZ #PADX GZ
TEST GZ < 1
TJMP WAGER_MIN
TEST GZ > 9
TJMP WAGER_MAX
JUMP WAGER_BANK_CAP

MARK WAGER_MIN
COPY 1 GZ
JUMP WAGER_CHANGED

MARK WAGER_MAX
COPY 9 GZ

MARK WAGER_BANK_CAP
TEST GZ > X
FJMP WAGER_CHANGED
COPY X GZ

MARK WAGER_CHANGED
MODE
COPY 1 M
MODE

MARK WAGER_RELEASE
WAIT
TEST #PADX = 0
FJMP WAGER_RELEASE
JUMP WAGER_LOOP

; Three-beat countdown.
MARK WAGER_DONE
MODE
COPY 2 M
MODE
COPY 3 T
MARK COUNTDOWN
REPL COUNTDOWN_DIGIT
MODE
COPY 3 M
MODE
@REP 10
WAIT
@END
SUBI T 1 T
TJMP COUNTDOWN

; Racers observe the two Start edges directly and begin after this countdown.
MODE
COPY 4 M
MODE

; First finish message wins. GM safely drains the other four as sole reader.
COPY M T
SWIZ T 0002 T
TEST T = CO
@REP 4
VOID M
@END
TJMP ROUND_WIN

MARK ROUND_LOSS
SUBI X GZ X
TEST X = 0
TJMP GAME_LOSS
MODE
COPY 6 M
MODE
REPL RESULT_BANK_HUNDREDS
REPL RESULT_BANK_TENS
REPL RESULT_BANK_ONES
REPL RESULT_L
REPL RESULT_O
REPL RESULT_S
REPL RESULT_E
JUMP RESULT_WAIT

MARK ROUND_WIN
COPY CO T
SUBI T 1 T
SEEK T
MULI F GZ T
SEEK -9999
ADDI X T X
TEST X > 255
TJMP GAME_WIN
MODE
COPY 5 M
MODE
REPL RESULT_BANK_HUNDREDS
REPL RESULT_BANK_TENS
REPL RESULT_BANK_ONES
REPL RESULT_W
REPL RESULT_I
REPL RESULT_N

; Show updated bank until Start, then create a fresh set of racers.
MARK RESULT_WAIT
WAIT
SWIZ #PADB 0004 T
FJMP RESULT_WAIT
COPY 1 CO
COPY 1 GZ
COPY 0 GX
COPY 14 GY
WAIT
JUMP ROUND_SETUP

; Terminal states match the original $256 and $0 bankroll goals.
MARK GAME_WIN
MODE
COPY 5 M
MODE
REPL TERM_Y
REPL TERM_O1
REPL TERM_U
REPL TERM_W
REPL TERM_I
REPL TERM_N
REPL TERM_BANK_HUNDREDS
REPL TERM_BANK_TENS
REPL TERM_BANK_ONES
JUMP TERMINAL

MARK GAME_LOSS
MODE
COPY 6 M
MODE
REPL TERM_N2
REPL TERM_O2
REPL TERM_C
REPL TERM_A
REPL TERM_S
REPL TERM_H
REPL TERM_BANK_HUNDREDS
REPL TERM_BANK_TENS
REPL TERM_BANK_ONES

MARK TERMINAL
WAIT
JUMP TERMINAL

; Finish-line worker. T contains lane Y.
MARK FINISH_LINE
COPY 300 GP
COPY 0 GZ
COPY 100 GX
COPY T GY
COPY 150 GP
COPY 151 GP
COPY 152 GP
COPY 153 GP
COPY 154 GP
COPY 155 GP
COPY 156 GP
COPY 157 GP
COPY 158 GP
COPY 159 GP
MARK FINISH_HOLD
WAIT
JUMP FINISH_HOLD

; Racer worker. Initial T contains racer ID; CO later stores ID*10+odds.
MARK RACER
COPY T CO

MARK RACER_SETUP
COPY 0 GZ
SUBI CO 1 T
MULI T 17 T
ADDI 14 T GY
COPY 300 GP
TEST CO = 1
TJMP ANIMAL_A
TEST CO = 2
TJMP ANIMAL_B
TEST CO = 3
TJMP ANIMAL_C
TEST CO = 4
TJMP ANIMAL_D
JUMP ANIMAL_E

MARK ANIMAL_A
COPY 120 GP
COPY 150 GP
COPY 121 GP
COPY 151 GP
COPY 122 GP
COPY 132 GP
COPY 142 GP
COPY 152 GP
COPY 113 GP
COPY 123 GP
COPY 133 GP
COPY 143 GP
COPY 153 GP
COPY 163 GP
COPY 104 GP
COPY 114 GP
COPY 134 GP
COPY 144 GP
COPY 164 GP
COPY 174 GP
COPY 115 GP
COPY 125 GP
COPY 135 GP
COPY 145 GP
COPY 155 GP
COPY 165 GP
COPY 126 GP
COPY 136 GP
COPY 146 GP
COPY 156 GP
COPY 127 GP
COPY 157 GP
COPY 118 GP
COPY 168 GP
JUMP RACER_READY

MARK ANIMAL_B
COPY 121 GP
COPY 131 GP
COPY 141 GP
COPY 151 GP
COPY 112 GP
COPY 122 GP
COPY 132 GP
COPY 142 GP
COPY 152 GP
COPY 162 GP
COPY 103 GP
COPY 113 GP
COPY 133 GP
COPY 143 GP
COPY 163 GP
COPY 173 GP
COPY 104 GP
COPY 114 GP
COPY 124 GP
COPY 134 GP
COPY 144 GP
COPY 154 GP
COPY 164 GP
COPY 174 GP
COPY 184 GP
COPY 194 GP
COPY 115 GP
COPY 125 GP
COPY 135 GP
COPY 145 GP
COPY 155 GP
COPY 165 GP
COPY 126 GP
COPY 136 GP
COPY 146 GP
COPY 156 GP
COPY 117 GP
COPY 167 GP
COPY 108 GP
COPY 178 GP
JUMP RACER_READY

MARK ANIMAL_C
COPY 100 GP
COPY 110 GP
COPY 160 GP
COPY 170 GP
COPY 111 GP
COPY 121 GP
COPY 151 GP
COPY 161 GP
COPY 122 GP
COPY 132 GP
COPY 142 GP
COPY 152 GP
COPY 113 GP
COPY 123 GP
COPY 133 GP
COPY 143 GP
COPY 153 GP
COPY 163 GP
COPY 104 GP
COPY 114 GP
COPY 124 GP
COPY 134 GP
COPY 144 GP
COPY 154 GP
COPY 164 GP
COPY 174 GP
COPY 105 GP
COPY 115 GP
COPY 135 GP
COPY 145 GP
COPY 165 GP
COPY 175 GP
COPY 116 GP
COPY 126 GP
COPY 136 GP
COPY 146 GP
COPY 156 GP
COPY 166 GP
COPY 127 GP
COPY 157 GP
COPY 118 GP
COPY 128 GP
COPY 158 GP
COPY 168 GP
JUMP RACER_READY

MARK ANIMAL_D
COPY 150 GP
COPY 160 GP
COPY 170 GP
COPY 141 GP
COPY 151 GP
COPY 161 GP
COPY 171 GP
COPY 132 GP
COPY 142 GP
COPY 152 GP
COPY 172 GP
COPY 113 GP
COPY 123 GP
COPY 133 GP
COPY 143 GP
COPY 153 GP
COPY 163 GP
COPY 104 GP
COPY 114 GP
COPY 124 GP
COPY 134 GP
COPY 144 GP
COPY 154 GP
COPY 164 GP
COPY 174 GP
COPY 125 GP
COPY 135 GP
COPY 145 GP
COPY 155 GP
COPY 165 GP
COPY 175 GP
COPY 136 GP
COPY 146 GP
COPY 156 GP
COPY 166 GP
COPY 127 GP
COPY 137 GP
COPY 167 GP
COPY 177 GP
COPY 118 GP
COPY 168 GP
JUMP RACER_READY

MARK ANIMAL_E
COPY 141 GP
COPY 151 GP
COPY 102 GP
COPY 132 GP
COPY 142 GP
COPY 152 GP
COPY 162 GP
COPY 192 GP
COPY 113 GP
COPY 123 GP
COPY 133 GP
COPY 143 GP
COPY 153 GP
COPY 163 GP
COPY 173 GP
COPY 183 GP
COPY 124 GP
COPY 134 GP
COPY 144 GP
COPY 154 GP
COPY 164 GP
COPY 174 GP
COPY 135 GP
COPY 145 GP
COPY 155 GP
COPY 165 GP
COPY 146 GP
COPY 156 GP
COPY 137 GP
COPY 167 GP
COPY 128 GP
COPY 178 GP

MARK RACER_READY
RAND 0 3 T
ADDI 10 T GX
MULI T -2 X
ADDI 6 X X
RAND 1 2 T
ADDI X T X
RAND 0 1 T
ADDI X T X
MULI CO 10 T
ADDI T X CO
REPL ODDS_DIGIT
COPY CO M

; Every racer sees the same two Start edges directly in the input host.
MARK RACER_RELEASE_PICK
WAIT
SWIZ #PADB 0004 T
TJMP RACER_RELEASE_PICK

MARK RACER_WAIT_PICK
WAIT
SWIZ #PADB 0004 T
FJMP RACER_WAIT_PICK

MARK RACER_RELEASE_WAGER
WAIT
SWIZ #PADB 0004 T
TJMP RACER_RELEASE_WAGER

MARK RACER_WAIT_WAGER
WAIT
SWIZ #PADB 0004 T
FJMP RACER_WAIT_WAGER

; Match GM's three ten-frame countdown beats.
@REP 30
WAIT
@END
RAND 1 2 T

MARK RACER_RUN
WAIT
SUBI T 1 T
TJMP RACER_RUN
ADDI GX 1 GX
COPY 218 GP
COPY 268 GP
TEST GX > 94
TJMP RACER_FINISH
RAND 2 3 T
JUMP RACER_RUN

MARK RACER_FINISH
COPY CO M
HALT

; Odds child persists through betting and disappears on the second Start.
MARK ODDS_DIGIT
SWIZ CO 0001 T
ADDI 327 T GP
COPY 0 GZ
COPY 110 GX
MARK ODDS_RELEASE_PICK
WAIT
SWIZ #PADB 0004 T
TJMP ODDS_RELEASE_PICK
MARK ODDS_WAIT_PICK
WAIT
SWIZ #PADB 0004 T
FJMP ODDS_WAIT_PICK
MARK ODDS_RELEASE_WAGER
WAIT
SWIZ #PADB 0004 T
TJMP ODDS_RELEASE_WAGER
MARK ODDS_WAIT_WAGER
WAIT
SWIZ #PADB 0004 T
FJMP ODDS_WAIT_WAGER
HALT

; Phase-lived bank display workers. CO selects betting, result, or terminal hold.
MARK BET_BANK_HUNDREDS
COPY 2 CO
JUMP BANK_HUNDREDS
MARK BET_BANK_TENS
COPY 2 CO
JUMP BANK_TENS
MARK BET_BANK_ONES
COPY 2 CO
JUMP BANK_ONES

MARK RESULT_BANK_HUNDREDS
COPY 1 CO
JUMP BANK_HUNDREDS
MARK RESULT_BANK_TENS
COPY 1 CO
JUMP BANK_TENS
MARK RESULT_BANK_ONES
COPY 1 CO
JUMP BANK_ONES

MARK TERM_BANK_HUNDREDS
COPY 0 CO
JUMP BANK_HUNDREDS
MARK TERM_BANK_TENS
COPY 0 CO
JUMP BANK_TENS
MARK TERM_BANK_ONES
COPY 0 CO
JUMP BANK_ONES

MARK BANK_HUNDREDS
COPY 300 GP
TEST X < 100
TJMP BANK_HOLD
DIVI X 100 T
ADDI 327 T GP
COPY 40 GX
COPY 0 GY
COPY 0 GZ
JUMP BANK_HOLD

MARK BANK_TENS
COPY 300 GP
TEST X < 10
TJMP BANK_HOLD
DIVI X 10 T
MODI T 10 T
ADDI 327 T GP
COPY 50 GX
COPY 0 GY
COPY 0 GZ
JUMP BANK_HOLD

MARK BANK_ONES
COPY 300 GP
MODI X 10 T
ADDI 327 T GP
COPY 60 GX
COPY 0 GY
COPY 0 GZ

MARK BANK_HOLD
TEST CO = 2
TJMP BANK_BET_RELEASE_PICK
TEST CO = 1
TJMP BANK_RESULT_WAIT
MARK BANK_TERM_HOLD
WAIT
JUMP BANK_TERM_HOLD

MARK BANK_BET_RELEASE_PICK
WAIT
SWIZ #PADB 0004 T
TJMP BANK_BET_RELEASE_PICK
MARK BANK_BET_WAIT_PICK
WAIT
SWIZ #PADB 0004 T
FJMP BANK_BET_WAIT_PICK
MARK BANK_BET_RELEASE_WAGER
WAIT
SWIZ #PADB 0004 T
TJMP BANK_BET_RELEASE_WAGER
MARK BANK_BET_WAIT_WAGER
WAIT
SWIZ #PADB 0004 T
FJMP BANK_BET_WAIT_WAGER
HALT

MARK BANK_RESULT_WAIT
WAIT
SWIZ #PADB 0004 T
FJMP BANK_RESULT_WAIT
HALT

MARK WAGER_DIGIT
COPY GZ T
COPY 0 GZ
ADDI 327 T GP
COPY 88 GX
WAIT
HALT

MARK COUNTDOWN_DIGIT
ADDI 327 T GP
COPY 0 GZ
COPY 55 GX
COPY 45 GY
@REP 10
WAIT
@END
HALT

; Normal result letters wait for reset, then disappear.
MARK RESULT_W
COPY 323 GP
COPY 45 GX
COPY 45 GY
JUMP RESULT_HOLD

MARK RESULT_I
COPY 309 GP
COPY 55 GX
COPY 45 GY
JUMP RESULT_HOLD

MARK RESULT_N
COPY 314 GP
COPY 65 GX
COPY 45 GY
JUMP RESULT_HOLD

MARK RESULT_L
COPY 312 GP
COPY 40 GX
COPY 45 GY
JUMP RESULT_HOLD

MARK RESULT_O
COPY 315 GP
COPY 50 GX
COPY 45 GY
JUMP RESULT_HOLD

MARK RESULT_S
COPY 319 GP
COPY 60 GX
COPY 45 GY
JUMP RESULT_HOLD

MARK RESULT_E
COPY 305 GP
COPY 70 GX
COPY 45 GY

MARK RESULT_HOLD
COPY 0 GZ
WAIT
SWIZ #PADB 0004 T
FJMP RESULT_HOLD
HALT

; Terminal YOUWIN and NOCASH letters persist.
MARK TERM_Y
COPY 325 GP
COPY 30 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_O1
COPY 315 GP
COPY 40 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_U
COPY 321 GP
COPY 50 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_W
COPY 323 GP
COPY 60 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_I
COPY 309 GP
COPY 70 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_N
COPY 314 GP
COPY 80 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_N2
COPY 314 GP
COPY 30 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_O2
COPY 315 GP
COPY 40 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_C
COPY 303 GP
COPY 50 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_A
COPY 301 GP
COPY 60 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_S
COPY 319 GP
COPY 70 GX
COPY 45 GY
JUMP TERM_HOLD

MARK TERM_H
COPY 308 GP
COPY 80 GX
COPY 45 GY

MARK TERM_HOLD
COPY 0 GZ
WAIT
JUMP TERM_HOLD
