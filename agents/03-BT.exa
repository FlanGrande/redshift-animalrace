; FlanGran.de boot logo and startup jingle.
COPY -10 GX
COPY -10 GY
MODE
REPL BOOT_SOUND

; Isometric flan body and plate: 14 core workers.
COPY 1 CO
COPY 40 GX
COPY 23 GY
REPL LOGO_TILE
