@REP 6
WAIT
@END

; Remaining rows: 4 sound workers.
LINK 801
COPY 15 CO
COPY 40 GX
COPY 53 GY
REPL LOGO_TILE
COPY 16 CO
COPY 50 GX
REPL LOGO_TILE
COPY 17 CO
COPY 60 GX
REPL LOGO_TILE
