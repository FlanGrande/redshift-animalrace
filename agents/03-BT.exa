COPY 300 GP
REPL TEXT_FL
@REP 3
WAIT
@END
COPY 43 T
REPL TEXT_AN
@REP 3
WAIT
@END
REPL TEXT_GR
@REP 3
WAIT
@END
COPY 63 T
REPL TEXT_AN
@REP 3
WAIT
@END
REPL TEXT_DOT_D
@REP 3
WAIT
@END
REPL TEXT_E

COPY 65 X
MARK BOOT_HOLD
WAIT
SUBI X 1 X
TEST X > 0
TJMP BOOT_HOLD

; Clear local workers in each host before waking game EXAs.
COPY 13 X
MARK CLEAR_SOUND
COPY 1 M
SUBI X 1 X
TEST X > 0
TJMP CLEAR_SOUND
LINK -1
LINK 800
COPY 19 X
MARK CLEAR_INPUT
COPY 1 M
SUBI X 1 X
TEST X > 0
TJMP CLEAR_INPUT
LINK -1
COPY 14 X
MARK CLEAR_CORE
COPY 1 M
SUBI X 1 X
TEST X > 0
TJMP CLEAR_CORE

; Return to global mode and wake GM, UI, and AU exactly once each.
MODE
@REP 3
COPY 1 M
@END
HALT

