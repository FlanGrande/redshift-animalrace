; Persistent BANK and ODDS headings.
REPL BANK_B
REPL BANK_A
REPL BANK_N
REPL BANK_K
REPL ODDS_O
REPL ODDS_D1
REPL ODDS_D2
REPL ODDS_S
HALT

MARK BANK_B
COPY 302 GP
COPY 0 GX
COPY 0 GY
JUMP HOLD

MARK BANK_A
COPY 301 GP
COPY 10 GX
COPY 0 GY
JUMP HOLD

MARK BANK_N
COPY 314 GP
COPY 20 GX
COPY 0 GY
JUMP HOLD

MARK BANK_K
COPY 311 GP
COPY 30 GX
COPY 0 GY
JUMP HOLD

MARK ODDS_O
COPY 315 GP
COPY 75 GX
COPY 0 GY
JUMP HOLD

MARK ODDS_D1
COPY 304 GP
COPY 85 GX
COPY 0 GY
JUMP HOLD

MARK ODDS_D2
COPY 304 GP
COPY 95 GX
COPY 0 GY
JUMP HOLD

MARK ODDS_S
COPY 319 GP
COPY 105 GX
COPY 0 GY

MARK HOLD
WAIT
JUMP HOLD
